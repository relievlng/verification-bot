# ---------------------------------------------------------------------------
# verification-bot (XZX bot) environment. Copy to .env and fill in the blanks:
#     cp .env.example .env && nano .env
# .env is gitignored - never commit real secrets.
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------
# Discord bot token (Developer Portal -> your app -> Bot -> Reset Token).
DISCORD_TOKEN=

# OAuth app (Developer Portal -> OAuth2). Needed for Discord account linking.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Public HTTPS address the bot's web server is reachable at. Stripe webhooks,
# license activation (/api/activate) and big-file download links all use this.
# On the VPS this is your domain behind nginx, e.g. https://api.xzxsuite.com
# It MUST start with https:// or download links are disabled.
PUBLIC_URL=https://api.xzxsuite.com

# Stripe webhook signing secret (Stripe Dashboard -> Developers -> Webhooks ->
# your endpoint -> Signing secret, starts with whsec_). Comma-separate several.
STRIPE_WEBHOOK_SECRET=

# --- Storage (persistent paths on the VPS) ----------------------------------
# SQLite database file. Use an ABSOLUTE path on a persistent disk so data
# survives restarts and redeploys.
DB_PATH=/opt/xzx-bot/data/verification.db

# Where uploaded product files are stored (absolute path, persistent).
FILES_DIR=/opt/xzx-bot/data/files

# Soft cap for total file storage (MB) and per-file upload limit (MB).
FILE_STORAGE_MB=10000
MAX_FILE_MB=1000

# --- Web server -------------------------------------------------------------
# Local port the aiohttp server binds to (nginx proxies to it). 8080 is fine;
# change it only if the gang bot (tenshi) on the same VPS also uses 8080.
PORT=8080

# --- Behaviour / optional ---------------------------------------------------
# Restrict the bot to specific servers (comma-separated guild IDs). Empty = all.
ALLOWED_GUILD_IDS=
GUILD_ID=

# Card theme: "black" (default B&W) or "color".
EMBED_THEME=black

# License key prefix shown to buyers, e.g. XZX-XXXX-XXXX.
LICENSE_PREFIX=XZX

# The XZX loader's API base (where the desktop loader calls /api/activate).
# Point this at the SAME public URL once the VPS is live.
XZX_API_BASE=https://api.xzxsuite.com

# Your Discord invite shown in cards.
DISCORD_INVITE=discord.gg/xzxx

# Turn on only if the Message Content intent is enabled in the Developer Portal
# (needed for message-content transcripts). Any non-empty value enables it.
MESSAGE_CONTENT=

# Extra hostnames Stripe is allowed to post from, comma-separated (rarely needed).
STRIPE_EXTRA_HOSTS=
