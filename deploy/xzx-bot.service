[Unit]
Description=XZX verification bot (Discord bot + web API)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xzxbot
Group=xzxbot
WorkingDirectory=/opt/xzx-bot
# bot.py loads .env from the working directory via python-dotenv, so no
# EnvironmentFile is needed here. Keep secrets in /opt/xzx-bot/.env (chmod 600).
ExecStart=/opt/xzx-bot/.venv/bin/python bot.py
Restart=always
RestartSec=5
# Give Discord/Stripe time to settle before systemd calls it failed.
StartLimitIntervalSec=300
StartLimitBurst=5
# Send stdout/stderr to the journal: view with  journalctl -u xzx-bot -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xzx-bot

# --- Hardening (kept conservative so Pillow/fontconfig caching still works) ---
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
# The data dir must stay writable (DB + uploaded files).
ReadWritePaths=/opt/xzx-bot/data

[Install]
WantedBy=multi-user.target
